# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only values; never expose these as NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# Bearer token the daily purge workflow sends to /api/cron/purge-document-files (feature 013).
CRON_SECRET=server-only-random-string

# Optional local/deployment values
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_FLEET_TIMEZONE=Asia/Manila
